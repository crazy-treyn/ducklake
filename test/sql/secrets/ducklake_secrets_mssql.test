# name: test/sql/secrets/ducklake_secrets_mssql.test
# description: DuckLake TYPE DUCKLAKE secret with MSSQL metadata (SQL auth)
# group: [secrets]

require ducklake

require parquet

require mssql

statement ok
CREATE SECRET dl_mssql_ci (
    TYPE DUCKLAKE,
    METADATA_PATH 'mssql:Server=127.0.0.1,1433;Database=ducklake_catalog;User Id=sa;Password=DuckLake_Test123!;Encrypt=true;TrustServerCertificate=true',
    DATA_PATH '__TEST_DIR__/mssql_secret_data',
    METADATA_PARAMETERS MAP {'TYPE': 'mssql'}
);

statement ok
ATTACH 'ducklake:dl_mssql_ci' AS lake

statement ok
CREATE TABLE lake.t(i INTEGER);

statement ok
INSERT INTO lake.t VALUES (7);

query I
SELECT i FROM lake.t
----
7

statement ok
DETACH lake

statement ok
ATTACH 'ducklake:dl_mssql_ci' AS lake2

query I
SELECT i FROM lake2.t
----
7
